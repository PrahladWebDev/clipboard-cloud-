# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Redis (clipboard data + pairing sessions cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session behaviour
SESSION_TTL_SECONDS=1800
CLIPBOARD_HISTORY_LIMIT=20
CLIPBOARD_AUTO_DELETE_SECONDS=3600

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# MongoDB (accounts + saved snippets — optional, only used by /auth and /account routes)
MONGODB_URI=mongodb://127.0.0.1:27017/clipboard-cloud

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
